{
    "manifest_version": 3,
    "name": "cringe-vaccine",
    "author": "Kumar Kislay",
    "version": "0.0.1",
    "description": "A LinkedIn feed filter that helps maintain professional content quality by identifying and hiding potentially inappropriate or low-quality posts.",
    "content_scripts": [
        {
            "js": [
                "scripts/content.js"
            ],
            "matches": [
                "https://www.linkedin.com/feed/*"
            ]
        }
    ],
    "icons": {
        "16": "images/icon.png",
        "32": "images/icon.png",
        "48": "images/icon.png",
        "128": "images/icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Cringe vaccine"
    },
    "permissions": [
        "activeTab",
        "storage" 
    ]
}
